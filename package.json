{
  "name": "elevenlabs-transcript-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node start.mjs",
    "start": "node start.mjs",
    "check": "node --check start.mjs && node --check server.mjs && node --check public/app.js && node --check scripts/supabase-admin.mjs",
    "supabase:status": "node --env-file=.env scripts/supabase-admin.mjs status",
    "supabase:list": "node --env-file=.env scripts/supabase-admin.mjs list",
    "supabase:stats": "node --env-file=.env scripts/supabase-admin.mjs stats"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "google-translate-api-x": "^10.7.3",
    "kuromoji": "^0.1.2",
    "wanakana": "^5.3.1"
  }
}
